# /etc/systemd/system/facemeet-backend.service
[Unit]
Description=FaceMeet backend (API + signaling + SFU)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/facemeet-refactor-backend
EnvironmentFile=/home/ubuntu/facemeet-refactor-backend/.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
