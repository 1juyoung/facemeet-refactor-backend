{
  "compilerOptions": {
    "types": [
      "node"
    ],
    "moduleDetection": "force",
    "module": "CommonJS",
    "target": "ES6",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES6",
      "dom"
    ],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src"
  ]
}
