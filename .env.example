PORT=3001
# MySQL 접속 주소 (Prisma). 형식: mysql://사용자:비밀번호@호스트:포트/DB이름
# 비밀번호에 @ : / 같은 특수문자가 있으면 URL 인코딩 필요 → 영문·숫자로만 만드는 것을 권장
DATABASE_URL=mysql://facemeet:yourpassword@localhost:3306/facemeet
JWT_SECRET=your_jwt_secret_change_this
FRONTEND_URL=http://localhost:3000

# ICE (WebRTC 연결)
STUN_URL=stun:stun.l.google.com:19302
# TURN 서버 주소 (쉼표로 여러 개 가능). 비워두면 STUN만 사용
TURN_URL=turn:your-domain:3478?transport=udp,turn:your-domain:3478?transport=tcp
# coturn의 static-auth-secret과 같은 값
TURN_SECRET=change_this_turn_secret
TURN_TTL_SECONDS=21600
